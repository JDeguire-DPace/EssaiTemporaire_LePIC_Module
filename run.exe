#!/bin/sh
i=$( date +%s )

rm -f DATA/*.*
rm -f DATA/DATA_2D/*.*

echo '*** Start calculation ... ***'
ulimit -s "unlimited"
#export FI_PROVIDER=tcp
export OMP_NUM_THREADS=16
export OMP_PROC_BIND=true
#export I_MPI_PIN_DOMAIN=omp
#export KMP_AFFINITY="verbose,explicit,proclist=[1,2,3]"
time mpirun -np 4 ./3dphpic.exe

set k=$0
j=$( date +%s )
k=$(($j-$i))
i=$(($k/60))
j=$(($k-$i*60))
echo -n " Total calculation time : "
echo $i "min" $j "sec"

